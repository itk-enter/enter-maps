COMPOSE_PROJECT_NAME=enter-maps
COMPOSE_DOMAIN=enter-maps.local.itkdev.dk
ITKDEV_TEMPLATE=symfony-8

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

# The login of the builder with OpenID Connect, on itk-dev/openid-connect-bundle.
# The defaults are for the mock provider in docker-compose.oidc.yml, which
# accepts any client id and secret. On a server, set the values of the real
# provider in .env.local.
OIDC_METADATA_URL=http://idp-employee.enter-maps.local.itkdev.dk/.well-known/openid-configuration
OIDC_CLIENT_ID=enter-maps
OIDC_CLIENT_SECRET=not-a-secret
# The claim of the ID token with the groups of the user, and the group that can use the builder.
OIDC_GROUPS_CLAIM=groups
OIDC_EMPLOYEE_GROUP=Employee

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# The address of the site, for example in the URLs that app:map-config:list gives.
DEFAULT_URI=http://enter-maps.local.itkdev.dk
###< symfony/routing ###

###> enter ###
# The base URI of Enter. The data proxy reads /sources.json and /ngsi-ld/v1/entities from it.
# The default is the nginx container of the Enter project on the same Docker host.
# If Enter runs with a different COMPOSE_PROJECT_NAME, change the container name in .env.local.
ENTER_BASE_URI=http://enter-nginx-1:8080
# Only on staging, where Enter is behind basic auth: set "user:password" in .env.local.
ENTER_BASIC_AUTH=
###< enter ###

###> adressevaelger ###
# The token of Adressevælger from Klimadatastyrelsen, for the address search on the map. The browser sends it, so it is
# not a secret. Klimadatastyrelsen asks all users to send this value until they give out tokens. If you get your own
# token, set it in .env.local.
ADRESSEVAELGER_TOKEN=adressevaelger123
# The address search gives only addresses in this municipality. 0751 is Aarhus. For another municipality, set its
# code in .env.local, for example 0101 for Copenhagen.
ADRESSEVAELGER_MUNICIPALITY_CODE=0751
###< adressevaelger ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="mysql://db:db@mariadb:3306/db?serverVersion=10.11.19-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
