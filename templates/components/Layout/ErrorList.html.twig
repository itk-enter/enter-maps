{% props title, errors %}
{# A list of errors at the top of a form, as an alert, so that a screen #}
{# reader reads it at once. The content, if any, goes below the errors, #}
{# for example a button that corrects them. #}
{% set actions %}{% block content %}{% endblock %}{% endset %}
<div role="alert" {{ attributes.defaults({class: 'rounded border-l-4 border-danger bg-surface-2 px-4 py-3'}) }}>
    <p class="m-0 font-semibold">{{ title }}</p>
    <ul class="m-0 mt-2 pl-5">
        {% for error in errors %}
            <li>{{ error }}</li>
        {% endfor %}
    </ul>
    {% if actions|trim is not empty %}
        <div class="mt-3 flex flex-wrap gap-3">{{ actions }}</div>
    {% endif %}
</div>
