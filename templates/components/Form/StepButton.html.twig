{% props controls, current = false, invalid = false %}
{# A button in the menu of the steps of a form. `controls` is the id of the #}
{# section of the step. `current` marks the step that the form shows. With #}
{# `invalid`, the button has a mark, because the step has an error. #}
<button type="button" aria-controls="{{ controls }}" {% if current %}aria-current="step"{% endif %} {{ attributes.defaults({class: 'flex w-full cursor-pointer items-center justify-between gap-2 rounded border-0 border-l-4 border-solid border-transparent bg-transparent px-3 py-2 text-left font-[inherit] text-[length:inherit] text-ink aria-[current=step]:border-primary aria-[current=step]:bg-surface-2 aria-[current=step]:font-bold'}) }}>
    <span>{%- block content %}{% endblock -%}</span>
    {% if invalid %}
        <span class="font-bold text-danger" aria-hidden="true">!</span>
        <span class="sr-only">{{ 'builder.form.step_error'|trans }}</span>
    {% endif %}
</button>
