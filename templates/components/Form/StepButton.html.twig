{% props controls = null, current = false, invalid = false, disabled = false, href = null, number = null %}
{# An item in the menu of the steps of a form. `controls` is the id of the #}
{# section of the step. `current` marks the step that the form shows. With #}
{# `invalid`, the item has a mark, because the step has an error. With #}
{# `href`, the item is a link to another page. A `disabled` item is grey, #}
{# and it is a disabled button, also if it has `href`. `number` shows the #}
{# number of the step in a circle before the text, so the menu shows the order. #}
{# Screen readers get the order from the list of the menu, so the number is hidden from them. #}
{% set classes = 'flex w-full cursor-pointer items-center justify-between gap-2 rounded border-0 border-l-4 border-solid border-transparent bg-transparent px-4 py-2.5 text-left font-[inherit] text-[length:inherit] text-ink no-underline aria-[current=step]:border-primary aria-[current=step]:bg-surface-2 aria-[current=step]:font-bold disabled:cursor-not-allowed disabled:text-text-muted disabled:opacity-60' %}
{% set content %}
    <span class="flex items-center gap-3">
        {%- if number is not null -%}
            <span aria-hidden="true" class="inline-flex size-7 flex-none items-center justify-center rounded-full border-2 border-solid border-current text-sm font-bold {{ current ? 'border-primary bg-primary text-on-primary' : '' }}">{{ number }}</span>
        {%- endif %}
        <span>{%- block content %}{% endblock -%}</span>
    </span>
    {% if invalid %}
        <span class="font-bold text-danger" aria-hidden="true">!</span>
        <span class="sr-only">{{ 'builder.form.step_error'|trans }}</span>
    {% endif %}
{% endset %}
{% if href and not disabled %}
    <a href="{{ href }}" {{ attributes.defaults({class: classes}) }}>{{ content }}</a>
{% else %}
    <button type="button" {% if controls %}aria-controls="{{ controls }}"{% endif %} {% if current %}aria-current="step"{% endif %} {% if disabled %}disabled{% endif %} {{ attributes.defaults({class: classes}) }}>{{ content }}</button>
{% endif %}
