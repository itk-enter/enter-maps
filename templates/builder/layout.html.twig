{% extends 'base.html.twig' %}
{# The layout of the builder: a header, the messages and the content. #}

{% block title %}{{ block('heading') }} · {{ 'builder.name'|trans }}{% endblock %}

{% block body %}
    {# A component cannot read the blocks of this template, so the heading #}
    {# goes into a variable first. #}
    {% set heading %}{{ block('heading') }}{% endset %}
    <twig:Layout:SkipLink href="#content">{{ 'builder.skip_link'|trans }}</twig:Layout:SkipLink>
    <header class="border-b border-line bg-surface-2">
        <div class="mx-auto max-w-5xl px-4 py-3">
            <a href="{{ path('app_builder') }}" class="font-bold text-ink no-underline">{{ 'builder.name'|trans }}</a>
        </div>
    </header>
    <main id="content" class="mx-auto flex max-w-5xl flex-col gap-8 px-4 py-8">
        <twig:Heading level="1" size="lg">{{ heading }}</twig:Heading>
        <twig:Layout:Flashes />
        {% block content %}{% endblock %}
    </main>
{% endblock %}
