{% extends 'builder/layout.html.twig' %}

{% block heading %}{{ 'builder.preview.title'|trans({'%title%': map.config.title}) }}{% endblock %}

{% block content %}
    <div class="flex flex-col gap-4">
        <ul class="m-0 flex list-none flex-wrap gap-x-4 gap-y-2 p-0">
            <li><twig:Form:Button href="{{ path('app_builder_edit', {id: map.id}) }}">{{ 'builder.preview.edit'|trans }}</twig:Form:Button></li>
            <li><twig:Form:Button variant="secondary" href="{{ path('app_builder_embed', {id: map.id}) }}">{{ 'builder.preview.embed'|trans }}</twig:Form:Button></li>
            <li><twig:Form:Button variant="secondary" href="{{ path('app_builder') }}">{{ 'builder.embed.back'|trans }}</twig:Form:Button></li>
        </ul>
        {# The map in the same frame as on another site, from the embed code. #}
        {{ code|raw }}
    </div>
{% endblock %}
