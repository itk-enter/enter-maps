{#- The embed script. EmbedCode::script() writes the code that loads it. -#}
/*
 * Enter maps: the embed script, version 1.
 *
 * Replaces each <div data-enter-map="{id}"> with the frame of the map. The
 * link in the div is the title of the frame, and the fallback if the page
 * blocks this script. The script sets the height of each frame from the
 * messages of the map:
 *
 * - If the sidebar is next to the map, the frame has a fixed height.
 * - Else the frame is as high as the map, up to the height of the window.
 *
 * The script accepts messages only from the site of the map, and only from
 * its own frames.
 */
(() => {
  const ORIGIN = {{ origin|json_encode|raw }};
  const HEIGHT = {{ height }};
  const ID = /^[0-9A-HJKMNP-TV-Z]{26}$/;
  // A page can load the script more than once, for example with two maps.
  // All copies share the sizes of the frames, and add the listeners once.
  const state = (window.enterMapScript ??= { sizes: new WeakMap(), listening: false });
  const { sizes } = state;

  const frames = () =>
    [...document.querySelectorAll("[data-enter-map] > iframe")].filter((frame) =>
      sizes.has(frame),
    );

  const fit = (frame) => {
    const size = sizes.get(frame);
    const height =
      size.wide || !size.height
        ? HEIGHT
        : Math.min(size.height, window.innerHeight);
    frame.style.height = `${height}px`;
  };

  const embed = (container) => {
    const id = container.dataset.enterMap;
    if (!ID.test(id) || container.querySelector(":scope > iframe")) {
      return;
    }

    const frame = document.createElement("iframe");
    frame.src = `${ORIGIN}/embed/leaflet/${id}?autoheight=1`;
    frame.title = container.querySelector("a")?.textContent.trim() ?? "";
    frame.loading = "lazy";
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    frame.style.cssText = `display:block;width:100%;height:${HEIGHT}px;border:0`;
    sizes.set(frame, { height: null, wide: false });
    container.replaceChildren(frame);
  };

  const start = () => document.querySelectorAll("[data-enter-map]").forEach(embed);

  if (!state.listening) {
    state.listening = true;

    window.addEventListener("message", (event) => {
      const { data } = event;
      if (
        event.origin !== ORIGIN ||
        data?.type !== "enter-map:height" ||
        !Number.isFinite(data.height) ||
        data.height <= 0
      ) {
        return;
      }

      const frame = frames().find((item) => item.contentWindow === event.source);
      if (frame) {
        sizes.set(frame, { height: Math.ceil(data.height), wide: data.wide === true });
        fit(frame);
      }
    });

    window.addEventListener("resize", () => frames().forEach(fit));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
})();
