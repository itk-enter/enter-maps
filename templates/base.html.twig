<!DOCTYPE html>
<html lang="{{ locale|default('da') }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Enter maps{% endblock %}</title>
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    {# On a narrow screen, the open detail view is the only thing that scrolls. #}
    <body class="max-wide:data-detail-open:overflow-hidden">
        {% block body %}{% endblock %}
    </body>
</html>
