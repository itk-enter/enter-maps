{# The form theme of the builder. It adds the classes of the design #}
{# tokens. The form_row block of Symfony connects the help and the errors #}
{# to the field with aria-describedby, so the theme keeps it. #}
{% use 'form_div_layout.html.twig' %}

{%- block form_row_render -%}
    {%- set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' mb-4 flex flex-col gap-1')|trim}) -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_help(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row_render -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' font-semibold')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' m-0 text-sm text-text-muted')|trim}) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_widget_simple -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' rounded border border-line bg-surface p-2 text-ink aria-invalid:border-danger')|trim}) -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="m-0 mt-1 list-none p-0 text-danger">
            {%- for error in errors -%}
                <li id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}
