{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enter-maps:map-config:v1",
  "title": "Map configuration, version 1",
  "description": "The configuration of one map. The converters make the settings of each renderer from it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "layers"],
  "properties": {
    "version": { "const": 1 },
    "title": { "$ref": "#/$defs/text" },
    "description": {
      "description": "A short text about the map, as plain text. The map shows it in the sidebar.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "locale": {
      "description": "The language of the texts on the map.",
      "enum": ["da-DK", "en-GB"]
    },
    "view": {
      "description": "The start view. Without it, the map shows all the features.",
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "zoom"],
      "properties": {
        "center": {
          "description": "Longitude and latitude, as in GeoJSON.",
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": { "$ref": "#/$defs/zoom" }
      }
    },
    "zoomGate": {
      "description": "Below minZoom, the map does not show the features.",
      "type": "object",
      "additionalProperties": false,
      "required": ["minZoom"],
      "properties": {
        "minZoom": { "$ref": "#/$defs/zoom" }
      }
    },
    "sidebar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": { "enum": ["left", "right"] },
        "list": { "type": "boolean" },
        "categories": { "type": "boolean" },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "local": { "type": "boolean" },
            "address": { "type": "boolean" }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/layer" }
    },
    "filters": {
      "description": "The open filters: controls in the sidebar.",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/filter" }
    },
    "report": {
      "description": "A link or a button in the detail view. {id} and {seeAlso} in the URL get the values of the entity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "pattern": "^https://", "maxLength": 500 },
        "target": { "enum": ["_blank", "_top", "postMessage"] }
      }
    },
    "leaflet": {
      "description": "Settings that only the Leaflet renderer uses.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseMap": {
          "description": "The name of the base map, from a list on the server. Not a URL.",
          "enum": ["osm"]
        }
      }
    },
    "septima": {
      "description": "Settings that only the Septima renderer uses.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseMap": {
          "description": "The name of the base map, from a list on the server. Not a URL.",
          "$ref": "#/$defs/name"
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 50 },
    "zoom": { "type": "number", "minimum": 0, "maximum": 22 },
    "path": {
      "description": "A dot path into the GeoJSON properties.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$",
      "maxLength": 200
    },
    "values": {
      "description": "Maps a code to a text.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "label": { "$ref": "#/$defs/text" },
        "fallback": { "$ref": "#/$defs/text" },
        "format": { "enum": ["text", "list", "boolean", "number", "date", "link"] },
        "values": { "$ref": "#/$defs/values" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataSet", "label", "row"],
      "properties": {
        "dataSet": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "maxLength": 200 },
        "label": { "$ref": "#/$defs/text" },
        "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "icon": { "$ref": "#/$defs/name" },
        "where": {
          "description": "The closed filter: an NGSI-LD query that the entities must also match.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "row": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "$ref": "#/$defs/field" },
            "subtitle": { "$ref": "#/$defs/field" }
          }
        },
        "detail": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "label", "values"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "type": { "enum": ["toggle", "select", "multiselect"] },
        "label": { "$ref": "#/$defs/text" },
        "values": { "$ref": "#/$defs/values" }
      }
    }
  }
}
